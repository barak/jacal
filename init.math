math : "Currently in math mode.";

/* the order in which initial conditions are defined matters */
/* the first initial condition defined is used to vet diffeq solutions */

exp(z) :: exp(z)'/z'=exp(z);
exp(0) ::= 1;
log ::~ exp;
log(1) ::= 0;
%e := exp(1);
log(%e) ::= 1;

%expPQ[n] := @2*%expPQ[n-1];
%expPQ[0] ::= 1;

%expt: exp(@2*log(@1));

sqrt(z) := z^(1/2);
cbrt := @1^(1/3);

tan(z) :: tan(z)'/z'=1+tan(z)^2;
tan(0) ::= 0;
atan ::~ tan;
atan(0) ::= 0;
tan(atan(1)) ::= 1;
atan(-1) ::= -atan(1);
tan(-atan(1)) ::= -1;
%pi := 4*atan(1);
tan(%pi) ::= 0;

%tanP[n] := @2*%tanQ[n-1]+%tanP[n-1];
%tanQ[n] := %tanQ[n-1]-@2*%tanP[n-1];
%tanP[0] ::= 0; %tanQ[0] ::= 1;
%tanPQ[n] := %tanP[n]/%tanQ[n];

cot(z) := 1/tan(z);
sec(z) := sqrt(1+tan(z)^2);
csc(z) := sec(z)/tan(z);
sin(z) := 1/csc(z);
cos(z) := 1/sec(z);
acot(z) := atan(1/z);
asec(z) := atan(sqrt(z^2-1));
acos(z) := atan(sqrt(1-z^2)/z);
asin(z) := atan(z/sqrt(1-z^2));
acsc(z) := atan(1/sqrt(z^2-1));

/* integrate(erf(x),x); --> x*erf(x) should be x*erf(x)+exp(-x^2)/sqrt(%pi) */
erf(z) :: erf(z)'/z'=exp(-z^2)/sqrt(atan(1));
erf(0) ::= 0;
fre ::~ erf;
fre(0) ::= 0;
erfc(z) := 1-erf(z);
erfi(z) := -%i*erf(%i*z);

/* Lambert W function, the inverse of x*exp(x) */
%W(z) ::~ z=%W*exp(%W);
%W(%e) ::= 1;
%W(0)  ::= 0;

lambert_w(z) :: lambert_w(z)'/z'=lambert_w(z)/(z*(1+lambert_w(z)));
lambert_w(%e) ::= 1;
lambert_w(0) ::= 0;

/* The rest are speculative: */

tanh(z) :: tanh(z)'/z'=1-tanh(z)^2;
tanh(0) ::= 0;
atanh ::~ tanh;
atanh(0) ::= 0;

%tanhP[n] := @2*%tanhQ[n-1]+%tanhP[n-1];
%tanhQ[n] := %tanhQ[n-1]+@2*%tanhP[n-1];
%tanhP[0] ::= 0; %tanhQ[0] ::= 1;
%tanhPQ[n] := %tanhP[n]/%tanhQ[n];

coth(x) := 1/tanh(x);
sech(z) := sqrt(1-tanh(z)^2);
csch(z) := sqrt(tanh(z)^-2-1);
cosh(z) := sqrt(1/(1-tanh(z)^2));
sinh(z) := 1/csch(z);

acoth(x) := atanh(1/x);

%skip %tanh(z) := -%i*tan(%i*z);
%skip %atanh(z) := %i*atan(-%i*z);

%skip gamma_incomplete(s,x) :: gamma_incomplete(s,x)'/x'=-x^(s-1)*exp(-x);
